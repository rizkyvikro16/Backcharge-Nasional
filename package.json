{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:pages": "vite build",
    "start": "node server.ts",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js dist/server.cjs",
    "lint": "tsc --noEmit",
    "deploy:pages": "npm run build:pages && npx wrangler pages deploy dist --project-name=backcharge-nasional",
    "deploy:worker": "npx wrangler deploy --config=wrangler.worker.toml",
    "deploy:all": "npm run deploy:pages && npm run deploy:worker"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "googleapis": "^173.0.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "multer": "^2.2.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "recharts": "^3.9.0",
    "sharp": "^0.35.5",
    "tsx": "^4.21.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "tailwindcss": "^4.1.14",
    "typescript": "~5.8.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}