{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "app-backcharge-assa",
  "main": "cloudflare-api-worker.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "backcharge-db",
      "database_id": "YOUR_D1_DATABASE_ID"
    }
  ]
}
