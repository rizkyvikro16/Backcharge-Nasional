# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# SUPABASE INTEGRATION:
# Create a Supabase project and get your URL and Anon/Public Key from Project Settings > API.
# Add these via the AI Studio Settings / Environment Variables menu.
VITE_SUPABASE_URL=""
VITE_SUPABASE_ANON_KEY=""

# GOOGLE DRIVE AUTOMATIC UPLOAD INTEGRATION (OAuth Client ID):
# (Metode Lama: Opsional jika ingin tetap memakai Login Klien)
VITE_GOOGLE_CLIENT_ID="966042883482-cuc8rcaai37mj888jsjb02pe6atp6qjl.apps.googleusercontent.com"

# GOOGLE DRIVE VIA GOOGLE APPS SCRIPT (Metode Paling Mudah & Bebas Error, Tanpa Google Cloud Console):
VITE_GOOGLE_APPS_SCRIPT_URL="https://script.google.com/macros/s/.../exec"

# GOOGLE DRIVE SERVICE ACCOUNT INTEGRATION (Sangat Direkomendasikan & Stabil jika memakai backend):
# 1. Tempel isi seluruh file JSON kredensial akun layanan Google Cloud di sini (satu baris):
GOOGLE_SERVICE_ACCOUNT_JSON='{"type": "service_account", "project_id": "...", ...}'
# 2. Atau jika ingin mengisi kunci privat & email secara terpisah:
GOOGLE_CLIENT_EMAIL="your-service-account-email@project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQ..."
# 3. ID Folder Google Drive tempat Anda ingin menyimpan file (Pastikan folder tersebut sudah di-share/bagikan ke email akun layanan di atas dengan akses Editor):
GOOGLE_DRIVE_FOLDER_ID="1234567890abcdefghijklmnopqrstuvwxyz"

